# ─────────────────────────────────────────────────────────────
# 공용 설정 — 비밀이 아닌 값만. 이 파일은 git 에 올라갑니다.
# 비밀번호·키는 .env.local 에 넣으세요 (git 에 안 올라감).
# ─────────────────────────────────────────────────────────────

PORT=4080
HOST=127.0.0.1

# 프론트(4050)에서 오는 요청만 허용
CORS_ORIGIN=http://localhost:4050

# 업로드 파일을 로컬에 저장할 때의 폴더 (GCS 를 쓰면 무시됨)
UPLOAD_DIR=uploads
