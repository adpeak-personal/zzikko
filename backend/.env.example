# .env.local 의 본보기.
#
#   cp .env.example .env.local
#
# 하고 값을 채우면 됩니다. 비밀이 아닌 설정(포트·CORS 등)은 .env 에 이미 들어 있고
# git 으로 같이 받으므로 따로 만들 필요가 없습니다.

# 로컬 MySQL — src/db/schema.sql 이 만드는 계정
# ⚠️ DB 이름은 zzikko 가 아니라 zzikko_cafe 다.
DATABASE_URL=mysql://zzikko_cafe:zzikko_local_dev@127.0.0.1:3306/zzikko_cafe

# 로그인 토큰 서명 키 — 없으면 서버가 뜨지 않는다. 사람마다 다른 값을 쓰면 된다.
# 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google Cloud Storage — 셋 다 채우면 GCS, 하나라도 비면 로컬 디스크에 저장한다.
# 서비스 계정 키(JSON)는 backend/gcs-key.json 에 두고 커밋하지 말 것.
# GCS_BUCKET=
# GCS_PROJECT=
# GCS_KEY_FILE=./gcs-key.json
# GCS_PUBLIC_HOST=
