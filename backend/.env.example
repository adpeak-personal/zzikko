# .env.local 의 본보기.
#
#   cp .env.example .env.local
#
# 하고 값을 채우면 됩니다. 비밀이 아닌 설정(포트·CORS 등)은 .env 에 이미 들어 있고
# git 으로 같이 받으므로 따로 만들 필요가 없습니다.

# 로컬 MySQL — src/db/schema.sql 이 만드는 계정
# ⚠️ DB 이름은 zzikko 가 아니라 zzikko_cafe 다.
DATABASE_URL=mysql://zzikko_cafe:zzikko_local_dev@127.0.0.1:3306/zzikko_cafe

# 로그인 토큰 서명 키 — 없으면 서버가 뜨지 않는다. 사람마다 다른 값을 쓰면 된다.
# 만들기: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# AWS S3 + CloudFront — 넷 다 채우면 S3, 하나라도 비면 로컬 디스크에 저장한다.
# AWS 계정 adpeak(590427064205) / 리전 서울. 키는 zzikko-img-uploader IAM 사용자 것.
# S3_BUCKET=zzikko-img-590427064205-ap-northeast-2-an
# AWS_REGION=ap-northeast-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# 이미지 공개 주소 (CloudFront). 비우면 S3 주소를 직접 쓴다 — CDN 만들기 전에도 동작한다.
# IMAGE_BASE_URL=https://dxxxxxxxxxxxxx.cloudfront.net

# 예전 공개 주소들, 쉼표로 구분. CDN 도메인을 바꿨을 때 DB 에 남은 옛 주소를 읽기 위한 것.
# IMAGE_LEGACY_BASE_URLS=

# 뒷정리 작업 (선택) — 글에 안 쓰인 이미지를 주기적으로 지웁니다.
# MAINTENANCE_ENABLED=false       끄기 (기본 켜짐)
# MAINTENANCE_INTERVAL_HOURS=6    도는 주기
# UPLOADS_GC_GRACE_HOURS=24       글에 안 쓰인 이미지를 지우기까지의 유예

# Anthropic — 시세표 이미지 읽기 + 시세 리포트 글 작성에 쓴다.
# 없으면 그 기능만 못 쓰고 서버는 그대로 뜬다. peak-crm 과 같은 키를 써도 된다.
# ANTHROPIC_API_KEY=
# ANTHROPIC_WORKSPACE_ID=        조직 키일 때만 (개인 키면 비워둘 것)
# 기본값은 둘 다 claude-haiku-5-5 이고, 그냥 두는 걸 권한다.
# - 표 읽기: 8개 양식 490칸을 Haiku 로 읽혀 전부 맞는 걸 확인했다. Opus 보다 35배 싸다.
# - 글 작성: 한동안 Sonnet 이었다. Haiku 가 존댓말 지시를 어겼기 때문인데, 글 구조를
#   blocks 로 바꾸며 프롬프트를 다시 쓴 뒤로는 그러지 않는다. 같은 시세표로 견줘 보니
#   숫자도 전부 맞고 건당 55원 → 4원이다.
# 글맛을 더 보고 싶을 때만 아래 줄로 올린다. **적어 두면 코드 기본값을 덮는다.**
# ANTHROPIC_MODEL=claude-haiku-5-5
# ANTHROPIC_WRITE_MODEL=claude-sonnet-5-5
# 수집함 제목 번역 — 어떤 소식인지 알아보려는 것뿐이라 가장 싼 모델로 고정돼 있다.
# ANTHROPIC_TRANSLATE_MODEL=claude-haiku-5-5

# 네이버 검색광고 API (선택) — 어느 지역 시세 글을 쓸지 고를 때 쓰는 월간검색수.
# 무료지만 호출 수 제한이 있어, 어드민에서 '검색량 가져오기'를 눌렀을 때만 부른다.
# 발급: manage.searchad.naver.com → 도구 → API 사용 관리 → API 라이선스 생성
# 없으면 그 버튼만 안 되고 시세 기능은 그대로 동작한다.
# NAVER_AD_API_KEY=
# NAVER_AD_SECRET_KEY=
# NAVER_AD_CUSTOMER_ID=
